# 用户配置
YIYI_DEPLOY_ROLE=single
# 安装脚本会同步部署角色，供直接执行 docker compose 命令使用。
COMPOSE_PROFILES=single
YIYI_SERVER_HOST=
YIYI_PUBLIC_HOST=
YIYI_LICENSE_SERVER_URL=https://license.190607.xyz

# 持久化数据根目录。留空时使用部署目录下的 data；也可以填写绝对或相对路径。
YIYI_DATA_DIR=

# PostgreSQL 配置。
# bundled：在 single/control 服务器安装内置 PostgreSQL。
# external：不安装内置 PostgreSQL，config/user/media 共用 YIYI_DB_HOST 指定的外部实例。
YIYI_DB_MODE=bundled
YIYI_DB_HOST=
YIYI_DB_PORT=5432
# bundled 模式下密码保持 GENERATE_ON_INSTALL 时由安装脚本生成；external 模式必须填写实际凭据。
YIYI_DB_USER=yiyi
YIYI_DB_PASSWORD=GENERATE_ON_INSTALL

# Redis 配置。
# Redis 密码留空表示不启用密码；填写 GENERATE_ON_INSTALL 可自动生成。
YIYI_REDIS_PASSWORD=

# 服务间鉴权 Token。保持 GENERATE_ON_INSTALL 时由安装脚本生成高熵随机值，也可以自行指定。
# 已有部署必须填写原 Token，不能重新生成，否则现有 Storage/Play 节点将无法通过鉴权。
YIYI_SERVICE_TOKEN=GENERATE_ON_INSTALL

# ============================================================
# 第三方登录（可选）
# ============================================================
# Telegram Bot（OTP 验证码 + Login Widget 一键登录）
# bot-token 从 @BotFather 获取；bot-username 是 bot 的 @用户名（不带 @）
YIYI_TELEGRAM_BOT_TOKEN=
YIYI_TELEGRAM_BOT_USERNAME=
# Telegram Mini App 对外访问地址，建议填写前端公网 HTTPS 地址。
YIYI_TELEGRAM_MINIAPP_URL=
# Telegram webhook secret_token。注册 webhook 时需传入相同的 secret_token。
YIYI_TELEGRAM_WEBHOOK_SECRET=
# Google 一键登录（OAuth Client ID，从 Google Cloud Console 获取）
YIYI_GOOGLE_CLIENT_ID=

# 仅分布式 Control 需要填写
YIYI_USER_HOST=
