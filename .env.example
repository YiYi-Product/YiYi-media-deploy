# 本机及集群地址。install.sh 会根据部署角色自动填写。
YIYI_SERVER_HOST=REPLACE_WITH_SERVER_IP_OR_DNS
YIYI_PUBLIC_HOST=REPLACE_WITH_SERVER_IP_OR_DNS
YIYI_ADVERTISE_HOST=REPLACE_WITH_SERVER_IP_OR_DNS
YIYI_DB_HOST=127.0.0.1
YIYI_REDIS_HOST=127.0.0.1
YIYI_CONFIG_HOST=127.0.0.1
YIYI_USER_HOST=127.0.0.1
YIYI_INFRA_BIND_HOST=127.0.0.1

# 集群凭据。主控安装时自动生成，其他服务器从 join.env 安全导入。
YIYI_DB_USER=yiyi
YIYI_DB_PASSWORD=GENERATE_ON_INSTALL
YIYI_REDIS_PASSWORD=GENERATE_ON_INSTALL
YIYI_SERVICE_TOKEN=GENERATE_ON_INSTALL
YIYI_LICENSE_CLUSTER_TOKEN=GENERATE_ON_INSTALL
YIYI_LICENSE_RELAY_LISTEN=
YIYI_LICENSE_SYNC_URL=https://127.0.0.1:18089/v1/lease
YIYI_LICENSE_SYNC_INTERVAL=30s
YIYI_DB_PORT=5432
YIYI_REDIS_PORT=6379

# Storage/Play 节点角色必须填写对应节点 ID。
YIYI_STORAGE_NODE_ID=NODE_NOT_CONFIGURED
YIYI_PLAY_AGENT_NODE_ID=NODE_NOT_CONFIGURED

# 以下版本配置由发布方维护，客户不需要修改。
YIYI_RELEASE_VERSION=e2e-20260803-5
YIYI_LICENSE_SERVER_URL=https://t.190607.xyz
YIYI_LICENSE_RENEW_INTERVAL=15m
