# YiYi Media 单机版部署（STANDALONE）环境变量模板。
#
# 适用模式：单机版部署 —— 一台服务器，yiyi-app + postgres + redis 三个容器，
# Storage 与 Play Agent 已内置在应用容器里，无需安装任何节点。
#
# 分布式部署请改用 .env.distributed.example 与 install-distributed.sh。
# 两种模式的变量不通用：本模板里没有 join.env、角色选择或节点安装变量。

# ============================================================
# 用户配置
# ============================================================
# 本机地址或域名，不带协议和路径，只允许 0-9 A-Z a-z . _ -
YIYI_SERVER_HOST=
# 公网访问地址。留空则回退为 YIYI_SERVER_HOST；只有网页入口与服务器地址不同时才填。
YIYI_PUBLIC_HOST=
# 授权中心地址。默认指向发布方提供的远端 HTTPS 授权中心。
# 内网/离线部署时若把授权中心跑在**同一台主机**上，可写：
#   http://127.0.0.1:<端口>          （宿主与部署脚本使用）
#   http://host.docker.internal:<端口>（容器内进程使用，compose 已配置 host-gateway）
# 二者都只允许回环/宿主网关地址；脚本仍会强校验公钥与镜像内置信任根一致。
YIYI_LICENSE_SERVER_URL=https://license.190607.xyz

# 持久化数据根目录。留空时使用部署目录下的 data；也可以填写绝对或相对路径，
# 安装脚本会规范化成绝对路径回写。
# 目录结构（计划 §6）：
#   data/postgres、data/redis、data/license/{identity,lease}、data/config/uploads、
#   data/storage/{mount-data,spool,read-cache}、
#   data/play-agent/{vfs-cache,image-cache}、
#   data/logs/{config,user,media,gateway,storage,play-agent,license}
YIYI_DATA_DIR=

# ============================================================
# 镜像
# ============================================================
# 聚合镜像标签，统一由本变量锁定，默认 latest（可变，每次 pull 可能拿到不同版本）。
# 生产环境建议锁定到不可变的版本标签（形如 2026.09.20-101530），
# 这样 `docker compose pull` 不会在无预期的情况下切换版本，也便于按版本回退。
# 可用版本列表见镜像仓库的 tags；聚合镜像同时发布 latest 与不可变时间标签。
YIYI_IMAGE_TAG=

# 端口发布。
# 应用容器的前端入口，默认发布到宿主机 0.0.0.0:18080。
YIYI_APP_PORT=18080
YIYI_APP_BIND_HOST=0.0.0.0
# 内置 Play Agent 默认只绑宿主机回环地址，供宿主机 nginx / Caddy 反代。
# 要让另一台机器上的反代访问，必须显式改成 0.0.0.0 或本机内网地址，
# 并在防火墙与安全组上限制来源 IP（计划 §5.3）。
YIYI_PLAY_AGENT_PORT=19090
YIYI_PLAY_AGENT_BIND_HOST=127.0.0.1

# ============================================================
# PostgreSQL（固定使用内置实例，不发布到宿主机）
# ============================================================
# 单机版不提供 external 模式：四个业务库固定由内置 PostgreSQL 承载。
YIYI_DB_USER=yiyi
# 保持 GENERATE_ON_INSTALL 时由安装脚本生成高熵随机值并回写。
# 检测到已有 PostgreSQL 数据时，脚本会强制要求填写原值，不会静默重新生成。
YIYI_DB_PASSWORD=GENERATE_ON_INSTALL

# ============================================================
# Redis（固定使用内置实例，不发布到宿主机）
# ============================================================
# Redis 密码留空表示不启用密码；填写 GENERATE_ON_INSTALL 可自动生成。
# 注意：留空是合法配置，不要为了"看起来配齐了"而写 GENERATE_ON_INSTALL。
YIYI_REDIS_PASSWORD=

# ============================================================
# 服务间令牌
# ============================================================
# 保持 GENERATE_ON_INSTALL 时由安装脚本生成高熵随机值，也可以自行指定。
# 已有部署必须填写原 Token，不能重新生成，否则原有节点身份与内部鉴权会失效。
YIYI_SERVICE_TOKEN=GENERATE_ON_INSTALL

# ============================================================
# 第三方登录（可选）
# ============================================================
# Telegram Bot（OTP 验证码 + Login Widget 一键登录）
# bot-token 从 @BotFather 获取；bot-username 是 bot 的 @用户名（不带 @）
YIYI_TELEGRAM_BOT_TOKEN=
YIYI_TELEGRAM_BOT_USERNAME=
# Telegram Mini App 对外访问地址，建议填写前端公网 HTTPS 地址。
YIYI_TELEGRAM_MINIAPP_URL=
# Telegram webhook secret_token。注册 webhook 时需传入相同的 secret_token。
YIYI_TELEGRAM_WEBHOOK_SECRET=
# Google 一键登录（OAuth Client ID，从 Google Cloud Console 获取）
YIYI_GOOGLE_CLIENT_ID=

# ============================================================
# 内置节点 ID（迁移旧部署时才需要关注）
# ============================================================
# 单机版固定内置一个 Storage 与一个 Play Agent，默认 ID 为 node-local-storage
# 与 node-local-play-agent。**全新安装不需要修改本节。**
#
# 从旧部署迁入单机版时：把这两个值设为**原有的节点 ID**，内置节点就会沿用
# 原来的记录，保住宿主媒体源的 nodeId 引用、用户播放线路授权与历史任务关联。
# 若不设置，系统会新建两个内置节点，旧节点记录会一直处于离线状态。
# 用 ./migrate-precheck.sh 可以先看到现有节点 ID 与影响范围。
YIYI_EMBEDDED_STORAGE_NODE_ID=node-local-storage
YIYI_EMBEDDED_PLAY_AGENT_NODE_ID=node-local-play-agent

# ============================================================
# 以下变量由 install.sh 自动维护，不要手工修改
# ============================================================
# 部署形态。安装脚本固定写入 STANDALONE。
# 它只用于收窄能力：产品能力边界始终以签名租约里的 edition claim 为准，
# 改这里不会扩大授权范围（计划 §3.1、§8.7）。
YIYI_DEPLOYMENT_MODE=STANDALONE
# 单机版不使用 Compose profile，这里必须是空值。
COMPOSE_PROFILES=
# 显式指向单机版 Compose 文件。仓库里还有 compose.distributed.yaml，
# 而 `docker compose` 会按固定文件名自动发现 compose.yaml；
# 写死这一项可以保证任何目录、任何调用方式都解析到正确的文件。
COMPOSE_FILE=compose.yaml
