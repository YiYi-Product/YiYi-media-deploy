# YiYi Media 分布式部署（DISTRIBUTED）—— 多机形态 环境变量模板。
#
# 每台机器设置不同的 YIYI_DEPLOY_ROLE，本机只跑该角色的服务：
#   control : postgres / redis / license-agent / config
#   user    : license-sync / user
#   media   : license-sync / media
#   edge    : license-sync / gateway / frontend
#
# 许可证要求：edition=DISTRIBUTED。
# 控制面全在一台机器：请用 v2-all-in-one 分支；单机版：main 分支。
#
# 用法（每台机器各做一次）：
#   cp .env.example .env，填写必填项与 YIYI_DEPLOY_ROLE，然后 sudo ./install.sh

# YiYi Media 分布式部署（DISTRIBUTED）环境变量模板。
#
# 适用模式：分布式部署 —— 控制面按 control / user / media / edge 角色拆分，
# 可异机部署；Storage 与 Play Agent 是外部工作节点，在网页「节点管理」创建后
# 自助部署，不由本模板安装。
#
# control、user、media、edge 是分布式部署**内部**的角色，不是独立部署模式。
# 单机版三容器部署请使用 .env.example 与 install.sh。
#
# 使用方式：每台机器 `cp .env.distributed.example .env`，填写本机角色与地址，
# 然后执行 `sudo ./install-distributed.sh`。

# ============================================================
# 用户配置
# ============================================================
# 本机在分布式部署中的角色，只支持 control / user / media / edge。
# 安装顺序固定为 control → user → media → edge，且必须位于同一私有网络。
YIYI_DEPLOY_ROLE=control
# 本机内网地址或域名，不带协议和路径，只允许 0-9 A-Z a-z . _ -
YIYI_SERVER_HOST=
# 公网访问地址。留空则回退为 YIYI_SERVER_HOST；只有 edge 的网页入口与服务器地址不同时才填。
YIYI_PUBLIC_HOST=
YIYI_LICENSE_SERVER_URL=https://license.190607.xyz
# 仅 control 必填：user 服务所在主机（内网地址或域名）。
YIYI_USER_HOST=

# 持久化数据根目录。留空时使用部署目录下的 data；也可以填写绝对或相对路径。
# control：postgres/(bundled)、redis/、config/uploads/、license/{identity,lease}/、logs/config/
# user   ：license/{sync-state,lease}/、logs/user/
# media  ：license/{sync-state,lease}/、logs/media/
# edge   ：license/{sync-state,lease}/、logs/gateway/
YIYI_DATA_DIR=

# ============================================================
# 镜像
# ============================================================
# 各服务镜像标签，统一由本变量锁定。生产环境建议锁定不可变版本标签。
YIYI_IMAGE_TAG=

# ============================================================
# PostgreSQL
# ============================================================
# bundled：在 control 上安装内置 PostgreSQL（首次初始化建四个库）。
# external：不安装内置 PostgreSQL，control 连接 YIYI_DB_HOST 指定的外部实例
#           （需预先建好四个库，可参考 postgres-init.sql）。
YIYI_DB_MODE=bundled
YIYI_DB_HOST=
YIYI_DB_PORT=5432
# bundled 模式下密码保持 GENERATE_ON_INSTALL 时由安装脚本生成；external 模式必须填写实际凭据。
YIYI_DB_USER=yiyi
YIYI_DB_PASSWORD=GENERATE_ON_INSTALL

# ============================================================
# Redis
# ============================================================
# 与数据库**独立**选择，可用任意组合（例如外部数据库 + 自带 Redis）。
# bundled ：control 角色在本机启动 redis 容器（默认）。
# external：使用你自己的 Redis，control 上**不启动** redis 容器；
#           control 角色必须填写 YIYI_REDIS_HOST。
YIYI_REDIS_MODE=bundled
YIYI_REDIS_HOST=
YIYI_REDIS_PORT=6379
# Redis 密码留空表示不启用密码；填写 GENERATE_ON_INSTALL 可自动生成。
# 分布式部署各角色共用同一个 Redis，密码必须与 control 一致。
YIYI_REDIS_PASSWORD=

# ============================================================
# 服务间令牌与集群同步令牌
# ============================================================
# 保持 GENERATE_ON_INSTALL 时由 control 上的安装脚本生成高熵随机值。
# 已有部署必须填写原 Token，不能重新生成，否则现有 Storage/Play 节点鉴权失败。
YIYI_SERVICE_TOKEN=GENERATE_ON_INSTALL
# 集群许可证同步令牌，至少 32 字符，control 与各节点必须一致。
# 它保护集群内的租约分发口 18089，随 join.env 分发到其他机器。
YIYI_LICENSE_CLUSTER_TOKEN=GENERATE_ON_INSTALL

# ============================================================
# 第三方登录（可选，只在 user 角色生效）
# ============================================================
YIYI_TELEGRAM_BOT_TOKEN=
YIYI_TELEGRAM_BOT_USERNAME=
YIYI_TELEGRAM_MINIAPP_URL=
YIYI_TELEGRAM_WEBHOOK_SECRET=
YIYI_GOOGLE_CLIENT_ID=

# ============================================================
# 以下变量由 install-distributed.sh 自动维护，不要手工修改
# ============================================================
# 部署形态。安装脚本固定写入 DISTRIBUTED。
# 它只用于收窄能力：产品能力边界始终以签名租约里的 edition claim 为准。
YIYI_DEPLOYMENT_MODE=DISTRIBUTED
# 供直接执行 docker compose 使用；安装脚本每次都会把它同步成当前角色。
COMPOSE_PROFILES=control
# 显式指向分布式 Compose 文件。仓库里还有单机版的 compose.yaml，
# 而 `docker compose` 会按固定文件名自动发现它；写死这一项可以保证
# 部署目录里直接执行 `docker compose ps` 解析到正确的文件。
COMPOSE_FILE=compose.yaml
# control 下 postgres 的副本数：external 模式由脚本写成 0。
YIYI_POSTGRES_REPLICAS=1
