# 用户配置
YIYI_DEPLOY_ROLE=single
YIYI_SERVER_HOST=
YIYI_PUBLIC_HOST=
YIYI_LICENSE_SERVER_URL=https://license.190607.xyz

# 持久化数据根目录。留空时使用部署目录下的 data；也可以填写绝对或相对路径。
YIYI_DATA_DIR=

# 数据库与缓存凭据。密码保持 GENERATE_ON_INSTALL 时由安装脚本生成。
YIYI_DB_USER=yiyi
YIYI_DB_PASSWORD=GENERATE_ON_INSTALL
YIYI_REDIS_PASSWORD=GENERATE_ON_INSTALL

# 仅分布式 Control 需要填写
YIYI_USER_HOST=
