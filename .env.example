# YiYi Media 分布式部署（DISTRIBUTED）—— 控制面同机形态 环境变量模板。
#
# 本机跑全部控制面服务；Storage 与 Play Agent 是外部工作节点，
# 在网页「节点管理」新增后用页面给出的一键命令部署到其他机器。
#
# 许可证要求：edition=DISTRIBUTED。
# 需要每个角色各一台机器：请用 v3-multi-host 分支。
#
# 用法：cp .env.example .env，填写以下必填项，然后 sudo ./install.sh
#   YIYI_SERVER_HOST   本机内网地址（其他节点要能访问到）
#   YIYI_PUBLIC_HOST   对外域名或公网 IP（浏览器访问用）
#   YIYI_DATA_DIR      数据根目录（备份时整个目录一起备）
#   YIYI_IMAGE_TAG     建议锁定到不可变版本标签，而不是 latest
#   YIYI_DB_PASSWORD   数据库口令（install.sh 会校验，不会回显）
#   YIYI_LICENSE_PUBLIC_JWK_FILE  授权中心公钥文件路径（信任根）

# 用户配置
# 本分支固定为控制面同机，无需选择角色（保留此行仅为兼容安装脚本读取）。
YIYI_DEPLOY_ROLE=single
# 安装脚本会同步部署角色，供直接执行 docker compose 命令使用。
COMPOSE_PROFILES=single
YIYI_SERVER_HOST=
YIYI_PUBLIC_HOST=
YIYI_LICENSE_SERVER_URL=https://license.190607.xyz

# 持久化数据根目录。留空时使用部署目录下的 data；也可以填写绝对或相对路径。
YIYI_DATA_DIR=

# ── PostgreSQL ──────────────────────────────────────────────────────────
# bundled ：本机启动 postgres 容器（默认）。
# external：使用你自己的 PostgreSQL，本机**不启动** postgres 容器。
#           external 时必须填写 YIYI_DB_HOST / YIYI_DB_USER / YIYI_DB_PASSWORD。
#           该实例需预先建好 yiyi_config / yiyi_user / yiyi_media / yiyi_storage
#           四个库（可参考 postgres-init.sql）。
YIYI_DB_MODE=bundled
# external 时填外部实例地址（不带协议与端口），bundled 时留空即可。
YIYI_DB_HOST=
YIYI_DB_PORT=5432
# bundled 模式下密码保持 GENERATE_ON_INSTALL 时由安装脚本生成；external 模式必须填写实际凭据。
YIYI_DB_USER=yiyi
YIYI_DB_PASSWORD=GENERATE_ON_INSTALL

# ── Redis ───────────────────────────────────────────────────────────────
# 与数据库**独立**选择，可用任意组合（例如外部数据库 + 自带 Redis）。
# bundled ：本机启动 redis 容器（默认）。
# external：使用你自己的 Redis，本机**不启动** redis 容器；
#           此时必须填写 YIYI_REDIS_HOST。
YIYI_REDIS_MODE=bundled
YIYI_REDIS_HOST=
YIYI_REDIS_PORT=6379
# Redis 密码留空表示不启用密码；填写 GENERATE_ON_INSTALL 可自动生成。
YIYI_REDIS_PASSWORD=

# 服务间鉴权 Token。保持 GENERATE_ON_INSTALL 时由安装脚本生成高熵随机值，也可以自行指定。
# 已有部署必须填写原 Token，不能重新生成。
YIYI_SERVICE_TOKEN=GENERATE_ON_INSTALL
# 节点平面密钥。新安装和旧版升级均由脚本自动生成并持久化；节点安装/升级命令会自动下发。
YIYI_NODE_TOKEN=GENERATE_ON_INSTALL

# 镜像标签。留空使用 latest（可变，每次 pull 可能拿到不同版本）。
# 建议生产环境锁定到不可变的版本标签（形如 2026.09.19-033520），
# 这样 `docker compose pull` 不会在无预期的情况下切换版本，也便于按版本回退。
# 可用版本列表见镜像仓库的 tags。
YIYI_IMAGE_TAG=

# ============================================================
# 第三方登录（可选）
# ============================================================
# Telegram Bot（OTP 验证码 + Login Widget 一键登录）
# bot-token 从 @BotFather 获取；bot-username 是 bot 的 @用户名（不带 @）
YIYI_TELEGRAM_BOT_TOKEN=
YIYI_TELEGRAM_BOT_USERNAME=
# Telegram Mini App 对外访问地址，建议填写前端公网 HTTPS 地址。
YIYI_TELEGRAM_MINIAPP_URL=
# Telegram webhook secret_token。注册 webhook 时需传入相同的 secret_token。
YIYI_TELEGRAM_WEBHOOK_SECRET=
# Google 一键登录（OAuth Client ID，从 Google Cloud Console 获取）
YIYI_GOOGLE_CLIENT_ID=

# 仅分布式 Control 需要填写
YIYI_USER_HOST=
